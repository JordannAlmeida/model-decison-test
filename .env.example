# Which model integration to use: jev | laya
MODEL_PROVIDER=laya

# Jev (hosted API, https://docs.typesafe.ai/api)
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
JEV_MODEL=jev-latest

# Laya (local docker server)
LAYA_API_URL=http://0.0.0.0:8000/v1/systemone
LAYA_MODEL=laya-latest

REQUEST_TIMEOUT=60
